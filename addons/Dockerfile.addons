# Build context: addons/
FROM golang:1.26-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
# Static, so the final image needs no libc.
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/addons ./cmd/addons

FROM gcr.io/distroless/static-debian12:latest
LABEL org.opencontainers.image.source=https://github.com/oakestra/oakestra
COPY --from=build /out/addons /addons

# Runs as root on purpose: the engine creates addon containers through the Docker socket
# (/var/run/docker.sock, mounted by compose), and the socket is only accessible to root or the
# docker group, whose GID differs per host. It is the only component that needs the socket.
USER 0:0

ENV ADDONS_MANAGER_PORT=11101 \
    ADDONS_ENGINE_MONGO_URL=localhost \
    ADDONS_ENGINE_MONGO_PORT=10007 \
    MARKETPLACE_ADDR=http://localhost:11102 \
    ORCHESTRATION_PLANE=root \
    ADDONS_STATE_DIR=/var/lib/oakestra-addons

# Holds the grant signing key and the instance id, created on first start. Losing it means
# re-approving every addon and orphaning their containers, so it has to outlive the container:
# mount a named volume here. The VOLUME line is the fallback that at least survives a compose
# recreate. Never share it with Mongo or an addon.
VOLUME ["/var/lib/oakestra-addons"]

ENTRYPOINT ["/addons"]
