# Build context: addons/
FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
# Only what the marketplace needs, so changes elsewhere in the module don't bust the cache.
COPY internal/definition ./internal/definition
COPY internal/auth ./internal/auth
COPY internal/httpx ./internal/httpx
COPY internal/marketplace ./internal/marketplace
COPY cmd/marketplace ./cmd/marketplace
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/marketplace ./cmd/marketplace

FROM gcr.io/distroless/static-debian12:nonroot
LABEL org.opencontainers.image.source=https://github.com/oakestra/oakestra
COPY --from=build /out/marketplace /marketplace
ENV ADDON_MARKETPLACE_PORT=11102 \
    ADDON_MARKETPLACE_MONGO_URL=localhost \
    ADDON_MARKETPLACE_MONGO_PORT=10007
EXPOSE 11102
USER nonroot:nonroot
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 CMD ["/marketplace", "healthcheck"]
ENTRYPOINT ["/marketplace"]
