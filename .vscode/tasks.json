{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "root-orchestrator-up",
            "type": "shell",
            "command": "SYSTEM_MANAGER_URL=$(ip -o route get to 8.8.8.8 | sed -nE 's/.*src ([0-9.]+).*/\\1/p') docker compose -f ${workspaceRoot}/root_orchestrator/docker-compose.yml -f ${workspaceRoot}/root_orchestrator/override-custom-service-manager-version.yml -f ${workspaceRoot}/root_orchestrator/override-network-host.yml up --build -d && sleep 1",
            "options": {
                "env": {
                    "COMPOSE_BAKE":"true",
                }
            }
        },
        {
            "label": "root-orchestrator-down",
            "type": "shell",
            "command": "docker compose -f ${workspaceRoot}/root_orchestrator/docker-compose.yml down",
        },
        {
            "label": "cluster-orchestrator-up",
            "type": "shell",
            "command": "HOST_IP=$(ip -o route get to 8.8.8.8 | sed -nE 's/.*src ([0-9.]+).*/\\1/p') && SYSTEM_MANAGER_URL=$HOST_IP CLUSTER_ADDRESS=$HOST_IP docker compose -f ${workspaceRoot}/cluster_orchestrator/docker-compose.yml -f ${workspaceRoot}/cluster_orchestrator/override-custom-service-manager-version.yml -f ${workspaceRoot}/cluster_orchestrator/override-network-host.yml up --build -d",
            "options": {
                "env": {
                    "CLUSTER_LOCATION": "48.13023160559729,11.583724427641824,100",
                    "CLUSTER_NAME": "debug_cluster",
                    "COMPOSE_BAKE":"true",
                }
            }
        },
        {
            "label": "cluster-orchestrator-down",
            "type": "shell",
            "command": "docker compose -f ${workspaceRoot}/cluster_orchestrator/docker-compose.yml down",
        },
        {
            "label": "remove-volumes",
            "type": "shell",
            "command": "docker volume rm -f $(docker volume ls -q) > /dev/null 2>&1 ; exit 0",
        },
        {
            "label": "remove-containers",
            "type": "shell",
            "command": "docker rm -f $(docker ps -a -q) > /dev/null 2>&1 ; exit 0",
        },

        // -------------------------------------------------- remove single containers
        // (frees the port/name so the locally-debugged process can take over)
        {
            "label": "remove-cluster-manager",
            "type": "shell",
            "command": "docker container rm -f cluster_manager",
            "problemMatcher": []
        },
        {
            "label": "remove-root-manager",
            "type": "shell",
            "command": "docker container rm -f system_manager",
            "problemMatcher": []
        },
        {
            "label": "remove-cluster-scheduler",
            "type": "shell",
            "command": "docker container rm -f cluster_scheduler",
            "problemMatcher": []
        },
        {
            "label": "remove-root-scheduler",
            "type": "shell",
            "command": "docker container rm -f root_scheduler",
            "problemMatcher": []
        },
        {
            "label": "remove-root-resource-abstractor",
            "type": "shell",
            "command": "docker container rm -f root_resource_abstractor",
            "problemMatcher": []
        },
        {
            "label": "remove-cluster-resource-abstractor",
            "type": "shell",
            "command": "docker container rm -f cluster_resource_abstractor",
            "problemMatcher": []
        },
        {
            "label": "remove-jwt-generator",
            "type": "shell",
            "command": "docker container rm -f jwt_generator",
            "problemMatcher": []
        },
        {
            "label": "remove-root-addons-manager",
            "type": "shell",
            "command": "docker container rm -f root_addons_manager",
            "problemMatcher": []
        },
        {
            "label": "remove-cluster-addons-manager",
            "type": "shell",
            "command": "docker container rm -f cluster_addons_manager",
            "problemMatcher": []
        },
        {
            "label": "remove-root-addons-monitor",
            "type": "shell",
            "command": "docker container rm -f root_addons_monitor",
            "problemMatcher": []
        },
        {
            "label": "remove-cluster-addons-monitor",
            "type": "shell",
            "command": "docker container rm -f cluster_addons_monitor",
            "problemMatcher": []
        },
        {
            "label": "remove-marketplace-manager",
            "type": "shell",
            "command": "docker container rm -f marketplace_manager",
            "problemMatcher": []
        },
        {
            "label": "set-default-cluster-to-node-engine",
            "type": "shell",
            "command": "cd ${workspaceRoot}/go_node_engine/build && ./build.sh && ./install.sh $(dpkg --print-architecture) && sudo NodeEngine config cluster 0.0.0.0",
            "problemMatcher": []
        },

        // -------------------------------------------------------- dependency installs
        {
            "label": "install-cluster-manager-dependencies",
            "type": "shell",
            "command": "uv sync --package cluster-manager",
            "problemMatcher": []
        },
        {
            "label": "install-root-manager-dependencies",
            "type": "shell",
            "command": "uv sync --package system-manager",
            "problemMatcher": []
        },
        {
            "label": "install-resource-abstractor-dependencies",
            "type": "shell",
            "command": "python3 -m venv ${workspaceRoot}/resource-abstractor/.venv && ${workspaceRoot}/resource-abstractor/.venv/bin/pip install -r ${workspaceRoot}/resource-abstractor/requirements.txt",
            "problemMatcher": []
        },
        {
            "label": "install-jwt-generator-dependencies",
            "type": "shell",
            "command": "python3 -m venv ${workspaceRoot}/root_orchestrator/jwt-generator/.venv && ${workspaceRoot}/root_orchestrator/jwt-generator/.venv/bin/pip install -r ${workspaceRoot}/root_orchestrator/jwt-generator/requirements.txt",
            "problemMatcher": []
        },
        {
            "label": "install-addons-manager-dependencies",
            "type": "shell",
            "command": "python3 -m venv ${workspaceRoot}/addons_engine/addons-manager/.venv && ${workspaceRoot}/addons_engine/addons-manager/.venv/bin/pip install -r ${workspaceRoot}/addons_engine/addons-manager/requirements.txt",
            "problemMatcher": []
        },
        {
            "label": "install-addons-monitor-dependencies",
            "type": "shell",
            "command": "python3 -m venv ${workspaceRoot}/addons_engine/addons-monitor/.venv && ${workspaceRoot}/addons_engine/addons-monitor/.venv/bin/pip install -r ${workspaceRoot}/addons_engine/addons-monitor/requirements.txt",
            "problemMatcher": []
        },
        {
            "label": "install-marketplace-manager-dependencies",
            "type": "shell",
            "command": "python3 -m venv ${workspaceRoot}/addons_marketplace/marketplace-manager/.venv && ${workspaceRoot}/addons_marketplace/marketplace-manager/.venv/bin/pip install -r ${workspaceRoot}/addons_marketplace/marketplace-manager/requirements.txt",
            "problemMatcher": []
        },
        {
            "label": "install-addons-dashboard-dependencies",
            "type": "shell",
            "command": "npm install",
            "options": {
                "cwd": "${workspaceRoot}/addons_engine/addons-dashboard"
            },
            "problemMatcher": []
        },
        {
            // Background Angular dev server used by the "Debug Addons Dashboard" launch.
            // The problemMatcher tells VS Code when `ng serve` is ready so the browser
            // debug session attaches at the right moment.
            "label": "serve-addons-dashboard",
            "type": "shell",
            "command": "npm start",
            "options": {
                "cwd": "${workspaceRoot}/addons_engine/addons-dashboard"
            },
            "isBackground": true,
            "dependsOn": ["install-addons-dashboard-dependencies"],
            "problemMatcher": {
                "owner": "typescript",
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "(Building|Watch mode enabled|Application bundle generation)",
                    "endsPattern": "(Application bundle generation complete|Compiled successfully|Local:\\s+http)"
                }
            }
        },

        // -------------------------------------------------------- prep-debug env tasks
        {
            "label": "prep-debug-node-engine-env",
            "dependsOn": [
                "root-orchestrator-up",
                "cluster-orchestrator-up",
                "set-default-cluster-to-node-engine",
            ],
            "dependsOrder": "sequence",
        },
        {
            "label": "prep-debug-cluster-manager-env",
            "dependsOn": [
                "root-orchestrator-up",
                "cluster-orchestrator-up",
                "remove-cluster-manager",
                "install-cluster-manager-dependencies",
                "generate-proto-files"
            ],
            "dependsOrder": "sequence",
        },
        {
            "label": "prep-debug-root-manager-env",
            "dependsOn": [
                "root-orchestrator-up",
                "remove-root-manager",
                "install-root-manager-dependencies",
                "generate-proto-files"
            ],
            "dependsOrder": "sequence",
        },
        {
            "label": "prep-debug-cluster-scheduler-env",
            "dependsOn": [
                "root-orchestrator-up",
                "cluster-orchestrator-up",
                "remove-cluster-scheduler"
            ],
            "dependsOrder": "sequence",
        },
        {
            "label": "prep-debug-root-scheduler-env",
            "dependsOn": [
                "root-orchestrator-up",
                "remove-root-scheduler"
            ],
            "dependsOrder": "sequence",
        },
        {
            "label": "prep-debug-root-resource-abstractor-env",
            "dependsOn": [
                "root-orchestrator-up",
                "remove-root-resource-abstractor",
                "install-resource-abstractor-dependencies"
            ],
            "dependsOrder": "sequence",
        },
        {
            "label": "prep-debug-cluster-resource-abstractor-env",
            "dependsOn": [
                "root-orchestrator-up",
                "cluster-orchestrator-up",
                "remove-cluster-resource-abstractor",
                "install-resource-abstractor-dependencies"
            ],
            "dependsOrder": "sequence",
        },
        {
            "label": "prep-debug-jwt-generator-env",
            "dependsOn": [
                "root-orchestrator-up",
                "remove-jwt-generator",
                "install-jwt-generator-dependencies"
            ],
            "dependsOrder": "sequence",
        },
        {
            "label": "prep-debug-root-addons-manager-env",
            "dependsOn": [
                "root-orchestrator-up",
                "remove-root-addons-manager",
                "install-addons-manager-dependencies"
            ],
            "dependsOrder": "sequence",
        },
        {
            "label": "prep-debug-cluster-addons-manager-env",
            "dependsOn": [
                "root-orchestrator-up",
                "cluster-orchestrator-up",
                "remove-cluster-addons-manager",
                "install-addons-manager-dependencies"
            ],
            "dependsOrder": "sequence",
        },
        {
            "label": "prep-debug-root-addons-monitor-env",
            "dependsOn": [
                "root-orchestrator-up",
                "remove-root-addons-monitor",
                "install-addons-monitor-dependencies"
            ],
            "dependsOrder": "sequence",
        },
        {
            "label": "prep-debug-cluster-addons-monitor-env",
            "dependsOn": [
                "root-orchestrator-up",
                "cluster-orchestrator-up",
                "remove-cluster-addons-monitor",
                "install-addons-monitor-dependencies"
            ],
            "dependsOrder": "sequence",
        },
        {
            "label": "prep-debug-marketplace-manager-env",
            "dependsOn": [
                "root-orchestrator-up",
                "remove-marketplace-manager",
                "install-marketplace-manager-dependencies"
            ],
            "dependsOrder": "sequence",
        },
        {
            "label": "generate-proto-files",
            "type": "shell",
            "command": "${command:python.interpreterPath} ${workspaceRoot}/scripts/generate_protos.py",
            "problemMatcher": []
        },
        {
            "label": "cleanup-debug-env",
            "type": "shell",
            "dependsOn": [
                "root-orchestrator-down",
                "cluster-orchestrator-down",
                "remove-containers",
                "remove-volumes"
            ]
        }
    ]
}
