{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "root-orchestrator-up",
            "type": "shell",
            "command": "SYSTEM_MANAGER_URL=$(bash ${workspaceRoot}/.vscode/scripts/host-ip.sh) docker compose -f ${workspaceRoot}/root_orchestrator/docker-compose.yml -f ${workspaceRoot}/root_orchestrator/override-network-host.yml up --build -d && bash ${workspaceRoot}/.vscode/scripts/wait-for-host-port.sh 10011 jwt_generator",
            "options": {
                "env": {
                    "COMPOSE_BAKE":"true",
                }
            }
        },
        {
            "label": "root-orchestrator-down",
            "type": "shell",
            "command": "docker compose -f ${workspaceRoot}/root_orchestrator/docker-compose.yml down",
        },
        {
            "label": "cluster-orchestrator-up",
            "type": "shell",
            "command": "HOST_IP=$(bash ${workspaceRoot}/.vscode/scripts/host-ip.sh) && SYSTEM_MANAGER_URL=$HOST_IP CLUSTER_ADDRESS=$HOST_IP docker compose -f ${workspaceRoot}/cluster_orchestrator/docker-compose.yml -f ${workspaceRoot}/cluster_orchestrator/override-network-host.yml up --build -d && bash ${workspaceRoot}/.vscode/scripts/wait-for-host-port.sh 10003 mqtt",
            "options": {
                "env": {
                    "CLUSTER_LOCATION": "48.13023160559729,11.583724427641824,100",
                    "CLUSTER_NAME": "debug_cluster",
                    "COMPOSE_BAKE":"true",
                }
            }
        },
        {
            "label": "cluster-orchestrator-down",
            "type": "shell",
            "command": "docker compose -f ${workspaceRoot}/cluster_orchestrator/docker-compose.yml down",
        },
        {
            "label": "remove-volumes",
            "type": "shell",
            "command": "docker volume rm -f $(docker volume ls -q) > /dev/null 2>&1 ; exit 0",
        },
        {
            "label": "remove-containers",
            "type": "shell",
            "command": "docker rm -f $(docker ps -a -q) > /dev/null 2>&1 ; exit 0",
        },

        // -------------------------------------------------- remove single containers
        // (frees the port/name so the locally-debugged process can take over)
        {
            "label": "remove-cluster-manager",
            "type": "shell",
            "command": "docker container rm -f cluster_manager",
            "problemMatcher": []
        },
        {
            "label": "remove-root-manager",
            "type": "shell",
            "command": "docker container rm -f system_manager",
            "problemMatcher": []
        },
        {
            "label": "remove-cluster-scheduler",
            "type": "shell",
            "command": "docker container rm -f cluster_scheduler",
            "problemMatcher": []
        },
        {
            "label": "remove-root-scheduler",
            "type": "shell",
            "command": "docker container rm -f root_scheduler",
            "problemMatcher": []
        },
        {
            "label": "remove-root-resource-abstractor",
            "type": "shell",
            "command": "docker container rm -f root_resource_abstractor",
            "problemMatcher": []
        },
        {
            "label": "remove-cluster-resource-abstractor",
            "type": "shell",
            "command": "docker container rm -f cluster_resource_abstractor",
            "problemMatcher": []
        },
        {
            "label": "remove-jwt-generator",
            "type": "shell",
            "command": "docker container rm -f jwt_generator",
            "problemMatcher": []
        },
        {
            "label": "remove-root-addons-manager",
            "type": "shell",
            "command": "docker container rm -f root_addons_manager",
            "problemMatcher": []
        },
        {
            "label": "remove-cluster-addons-manager",
            "type": "shell",
            "command": "docker container rm -f cluster_addons_manager",
            "problemMatcher": []
        },
        {
            "label": "remove-root-addons-monitor",
            "type": "shell",
            "command": "docker container rm -f root_addons_monitor",
            "problemMatcher": []
        },
        {
            "label": "remove-cluster-addons-monitor",
            "type": "shell",
            "command": "docker container rm -f cluster_addons_monitor",
            "problemMatcher": []
        },
        {
            "label": "remove-marketplace-manager",
            "type": "shell",
            "command": "docker container rm -f marketplace_manager",
            "problemMatcher": []
        },
        {
            "label": "remove-root-service-manager",
            "type": "shell",
            "command": "docker container rm -f root_service_manager",
            "problemMatcher": []
        },
        {
            "label": "remove-cluster-service-manager",
            "type": "shell",
            "command": "docker container rm -f cluster_service_manager",
            "problemMatcher": []
        },
        {
            "label": "set-default-cluster-to-node-engine",
            "type": "shell",
            "command": "cd ${workspaceRoot}/node_engine/build && ./build.sh && ./install.sh $(dpkg --print-architecture) && sudo NodeEngine config cluster 0.0.0.0",
            "problemMatcher": []
        },
        {
            // Points the NodeEngine at the NetManager socket instead of the netmanager service,
            // so it talks to the NetManager started by "Debug Net Manager".
            "label": "set-node-engine-network-manual",
            "type": "shell",
            "command": "sudo NodeEngine config network manual",
            "problemMatcher": []
        },
        {
            // The NodeEngine starts the netmanager service itself ("Debug Node Engine").
            "label": "set-node-engine-network-auto",
            "type": "shell",
            "command": "sudo NodeEngine config network auto",
            "problemMatcher": []
        },
        {
            // Builds the NetManager from this repo and installs it as the netmanager service.
            "label": "install-net-manager",
            "type": "shell",
            "command": "cd ${workspaceRoot}/net_manager/build && ./build.sh && ./install.sh $(dpkg --print-architecture)",
            "problemMatcher": []
        },
        {
            // Background preLaunch of "Debug Net Manager": starts the nodeengine service once the
            // debugged NetManager listens on its socket. The debug session starts at "Waiting for".
            "label": "start-node-engine-after-net-manager",
            "type": "shell",
            "command": "bash ${workspaceRoot}/.vscode/scripts/start-node-engine-after-net-manager.sh",
            "isBackground": true,
            "presentation": {
                "panel": "dedicated"
            },
            "problemMatcher": {
                "owner": "oakestra",
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^$",
                    "endsPattern": "^Waiting for NetManager socket"
                }
            }
        },
        {
            "label": "stop-node-engine-service",
            "type": "shell",
            "command": "sudo systemctl stop nodeengine",
            "problemMatcher": []
        },
        {
            // Installs the default NetManager config (if missing) and stops the installed
            // netmanager service, so the debugged NetManager owns the socket and port 50103.
            "label": "install-net-manager-config",
            "type": "shell",
            "command": "sudo mkdir -p /etc/netmanager /var/log/oakestra && ( [ -e /etc/netmanager/netcfg.json ] || sudo cp ${workspaceRoot}/net_manager/config/netcfg.json ${workspaceRoot}/net_manager/config/tuncfg.json /etc/netmanager/ ) && ( sudo systemctl stop netmanager 2>/dev/null || true )",
            "problemMatcher": []
        },

        // -------------------------------------------------------- dependency installs
        // uv-managed components (system-manager, cluster-manager, shared libraries) share the
        // root .venv populated by `uv sync`. Every other Python component gets its own
        // virtualenv in <component-dir>/.venv (see .vscode/scripts/ensure-venv.sh): their pinned
        // dependencies conflict, and `uv sync` would remove them from the root .venv.
        {
            "label": "install-cluster-manager-dependencies",
            "type": "shell",
            "command": "uv sync --all-packages",
            "problemMatcher": []
        },
        {
            "label": "install-root-manager-dependencies",
            "type": "shell",
            "command": "uv sync --all-packages",
            "problemMatcher": []
        },
        {
            "label": "install-resource-abstractor-dependencies",
            "type": "shell",
            "command": "bash ${workspaceRoot}/.vscode/scripts/ensure-venv.sh resource-abstractor ${command:python.interpreterPath} -r resource-abstractor/requirements.txt libraries/oakestra_logging",
            "problemMatcher": []
        },
        {
            "label": "install-root-service-manager-dependencies",
            "type": "shell",
            "command": "bash ${workspaceRoot}/.vscode/scripts/ensure-venv.sh root_orchestrator/service-manager ${command:python.interpreterPath} -r root_orchestrator/service-manager/requirements.txt",
            "problemMatcher": []
        },
        {
            "label": "install-cluster-service-manager-dependencies",
            "type": "shell",
            "command": "bash ${workspaceRoot}/.vscode/scripts/ensure-venv.sh cluster_orchestrator/service-manager ${command:python.interpreterPath} -r cluster_orchestrator/service-manager/requirements.txt",
            "problemMatcher": []
        },
        {
            "label": "install-jwt-generator-dependencies",
            "type": "shell",
            "command": "bash ${workspaceRoot}/.vscode/scripts/ensure-venv.sh root_orchestrator/jwt-generator ${command:python.interpreterPath} -r root_orchestrator/jwt-generator/requirements.txt libraries/oakestra_logging",
            "problemMatcher": []
        },
        {
            "label": "install-addons-manager-dependencies",
            "type": "shell",
            "command": "bash ${workspaceRoot}/.vscode/scripts/ensure-venv.sh addons_engine/addons-manager ${command:python.interpreterPath} -r addons_engine/addons-manager/requirements.txt libraries/oakestra_logging",
            "problemMatcher": []
        },
        {
            "label": "install-addons-monitor-dependencies",
            "type": "shell",
            "command": "bash ${workspaceRoot}/.vscode/scripts/ensure-venv.sh addons_engine/addons-monitor ${command:python.interpreterPath} -r addons_engine/addons-monitor/requirements.txt libraries/oakestra_logging",
            "problemMatcher": []
        },
        {
            "label": "install-marketplace-manager-dependencies",
            "type": "shell",
            "command": "bash ${workspaceRoot}/.vscode/scripts/ensure-venv.sh addons_marketplace/marketplace-manager ${command:python.interpreterPath} -r addons_marketplace/marketplace-manager/requirements.txt libraries/oakestra_logging",
            "problemMatcher": []
        },
        {
            "label": "install-addons-dashboard-dependencies",
            "type": "shell",
            "command": "npm install",
            "options": {
                "cwd": "${workspaceRoot}/addons_engine/addons-dashboard"
            },
            "problemMatcher": []
        },
        {
            // Background Angular dev server used by the "Debug Addons Dashboard" launch.
            // The problemMatcher tells VS Code when `ng serve` is ready so the browser
            // debug session attaches at the right moment.
            "label": "serve-addons-dashboard",
            "type": "shell",
            "command": "npm start",
            "options": {
                "cwd": "${workspaceRoot}/addons_engine/addons-dashboard"
            },
            "isBackground": true,
            "dependsOn": ["install-addons-dashboard-dependencies"],
            "problemMatcher": {
                "owner": "typescript",
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "(Building|Watch mode enabled|Application bundle generation)",
                    "endsPattern": "(Application bundle generation complete|Compiled successfully|Local:\\s+http)"
                }
            }
        },

        // -------------------------------------------------------- prep-debug env tasks
        {
            "label": "prep-debug-node-engine-env",
            "dependsOn": [
                "root-orchestrator-up",
                "cluster-orchestrator-up",
                "set-default-cluster-to-node-engine",
                "install-net-manager",
                "set-node-engine-network-auto",
            ],
            "dependsOrder": "sequence",
        },
        {
            "label": "prep-debug-net-manager-env",
            "dependsOn": [
                "root-orchestrator-up",
                "cluster-orchestrator-up",
                "set-default-cluster-to-node-engine",
                "set-node-engine-network-manual",
                "install-net-manager-config",
                "start-node-engine-after-net-manager",
            ],
            "dependsOrder": "sequence",
        },
        {
            "label": "prep-debug-root-service-manager-env",
            "dependsOn": [
                "root-orchestrator-up",
                "remove-root-service-manager",
                "install-root-service-manager-dependencies"
            ],
            "dependsOrder": "sequence",
        },
        {
            "label": "prep-debug-cluster-service-manager-env",
            "dependsOn": [
                "root-orchestrator-up",
                "cluster-orchestrator-up",
                "remove-cluster-service-manager",
                "install-cluster-service-manager-dependencies"
            ],
            "dependsOrder": "sequence",
        },
        {
            "label": "prep-debug-cluster-manager-env",
            "dependsOn": [
                "root-orchestrator-up",
                "cluster-orchestrator-up",
                "remove-cluster-manager",
                "install-cluster-manager-dependencies",
                "generate-proto-files"
            ],
            "dependsOrder": "sequence",
        },
        {
            "label": "prep-debug-root-manager-env",
            "dependsOn": [
                "root-orchestrator-up",
                "remove-root-manager",
                "install-root-manager-dependencies",
                "generate-proto-files"
            ],
            "dependsOrder": "sequence",
        },
        {
            "label": "prep-debug-cluster-scheduler-env",
            "dependsOn": [
                "root-orchestrator-up",
                "cluster-orchestrator-up",
                "remove-cluster-scheduler"
            ],
            "dependsOrder": "sequence",
        },
        {
            "label": "prep-debug-root-scheduler-env",
            "dependsOn": [
                "root-orchestrator-up",
                "remove-root-scheduler"
            ],
            "dependsOrder": "sequence",
        },
        {
            "label": "prep-debug-root-resource-abstractor-env",
            "dependsOn": [
                "root-orchestrator-up",
                "remove-root-resource-abstractor",
                "install-resource-abstractor-dependencies"
            ],
            "dependsOrder": "sequence",
        },
        {
            "label": "prep-debug-cluster-resource-abstractor-env",
            "dependsOn": [
                "root-orchestrator-up",
                "cluster-orchestrator-up",
                "remove-cluster-resource-abstractor",
                "install-resource-abstractor-dependencies"
            ],
            "dependsOrder": "sequence",
        },
        {
            "label": "prep-debug-jwt-generator-env",
            "dependsOn": [
                "root-orchestrator-up",
                "remove-jwt-generator",
                "install-jwt-generator-dependencies"
            ],
            "dependsOrder": "sequence",
        },
        {
            "label": "prep-debug-root-addons-manager-env",
            "dependsOn": [
                "root-orchestrator-up",
                "remove-root-addons-manager",
                "install-addons-manager-dependencies"
            ],
            "dependsOrder": "sequence",
        },
        {
            "label": "prep-debug-cluster-addons-manager-env",
            "dependsOn": [
                "root-orchestrator-up",
                "cluster-orchestrator-up",
                "remove-cluster-addons-manager",
                "install-addons-manager-dependencies"
            ],
            "dependsOrder": "sequence",
        },
        {
            "label": "prep-debug-root-addons-monitor-env",
            "dependsOn": [
                "root-orchestrator-up",
                "remove-root-addons-monitor",
                "install-addons-monitor-dependencies"
            ],
            "dependsOrder": "sequence",
        },
        {
            "label": "prep-debug-cluster-addons-monitor-env",
            "dependsOn": [
                "root-orchestrator-up",
                "cluster-orchestrator-up",
                "remove-cluster-addons-monitor",
                "install-addons-monitor-dependencies"
            ],
            "dependsOrder": "sequence",
        },
        {
            "label": "prep-debug-marketplace-manager-env",
            "dependsOn": [
                "root-orchestrator-up",
                "remove-marketplace-manager",
                "install-marketplace-manager-dependencies"
            ],
            "dependsOrder": "sequence",
        },
        {
            "label": "generate-proto-files",
            "type": "shell",
            "command": "uv sync --all-packages && ${workspaceRoot}/.venv/bin/python ${workspaceRoot}/scripts/generate_protos.py",
            "problemMatcher": []
        },
        {
            "label": "cleanup-debug-env",
            "type": "shell",
            "dependsOn": [
                "root-orchestrator-down",
                "cluster-orchestrator-down",
                "remove-containers",
                "remove-volumes"
            ]
        }
    ]
}
