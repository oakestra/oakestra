{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Cluster Manager",
            "type": "python",
            "request": "launch",
            "module": "flask",
            "env": {
                "FLASK_APP": "app.py",
                "FLASK_ENV": "development",
                "FLASK_DEBUG": "1"
            },
            "args": [
                "run",
                "--no-debugger",
                "--no-reload",
                "--port", "5000"
            ],
            "jinja": true,
            "justMyCode": true,
            "preLaunchTask": "cluster-orchestrator-up"
        },
        {
            "name": "Cluster Scheduler",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/go_node_engine/scheduler",
            "args": [],
            "env": {},
            "preLaunchTask": "cluster-orchestrator-up"
        },
        {
            "name": "Node Engine",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/go_node_engine",
            "args": [
                "--runtime", "containerd",
                "--node-id", "dev-node-1"
            ],
            "env": {},
            "preLaunchTask": "cluster-orchestrator-up"
        }
    ]
}
